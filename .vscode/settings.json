{
  // ─── Python ─────────────────────────────────────────────
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "python.analysis.extraPaths": ["${workspaceFolder}"],
  "python.analysis.typeCheckingMode": "basic",
  "python.testing.pytestEnabled": true,
  "python.testing.pytestArgs": ["tests"],
  "python.testing.unittestEnabled": false,

  // ─── Ruff (lint + format) ───────────────────────────────
  "ruff.enable": true,
  "ruff.organizeImports": true,
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.organizeImports.ruff": "explicit",
      "source.fixAll.ruff": "explicit"
    }
  },

  // ─── Frontend (TypeScript / React / Tailwind) ──────────
  // typescript / typescriptreact 언어 블록은 하나로 merge — JSONC 는 duplicate key
  // 를 허용하지만 마지막 선언이 앞 선언을 완전히 덮어써 formatter 설정이 silently
  // 사라질 위험 있음 (이전에 line 23/44 중복으로 severity-4 경고).
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.tabSize": 2,
    "editor.codeActionsOnSave": {
      "source.fixAll.eslint": "explicit"
    }
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.tabSize": 2,
    "editor.codeActionsOnSave": {
      "source.fixAll.eslint": "explicit"
    }
  },
  "eslint.workingDirectories": [{ "pattern": "frontend" }],
  "tailwindCSS.experimental.classRegex": [
    ["clsx\\(([^)]*)\\)", "(?:'|\"|`)([^']*)(?:'|\"|`)"],
    ["cn\\(([^)]*)\\)", "(?:'|\"|`)([^']*)(?:'|\"|`)"]
  ],
  "tailwindCSS.includeLanguages": {
    "typescript": "javascript",
    "typescriptreact": "javascript"
  },
  // codex-reviews archive (gitignored) 는 real source 가 아닌 codex 응답 markdown —
  // 내부에 인용된 arbitrary-value class (e.g. `min-w-[200px]`) 가 canonical-class
  // suggest 경고를 trigger 하므로 tailwind scan 제외. data/ 아래 report 도 동일 이유.
  "tailwindCSS.files.exclude": [
    "**/.venv/**",
    "**/node_modules/**",
    "**/.next/**",
    "codex-reviews/**",
    "data/**"
  ],

  // ─── Editor ─────────────────────────────────────────────
  "editor.formatOnSave": true,
  "editor.rulers": [120],
  "editor.tabSize": 4,
  "[json]": { "editor.tabSize": 2 },
  "[yaml]": { "editor.tabSize": 2 },

  // ─── Files ──────────────────────────────────────────────
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true,
  "files.exclude": {
    "**/__pycache__": true,
    "**/*.pyc": true,
    "**/.pytest_cache": true,
    "**/.ruff_cache": true,
    "**/.mypy_cache": true,
    "**/*.egg-info": true,
    "**/.coverage": true,
    "**/coverage.xml": true,
    "**/htmlcov": true,
    "**/.next": true,
    "**/.turbo": true,
    "frontend/node_modules": true,
    "data/.bfg-reports": true
  },
  "files.watcherExclude": {
    "**/.venv/**": true,
    "**/node_modules/**": true,
    "**/data/reports/**": true,
    "**/data/backups/**": true,
    "**/.git/**": true
  },

  // ─── Search ─────────────────────────────────────────────
  "search.exclude": {
    "**/.venv": true,
    "**/node_modules": true,
    "**/data/reports": true,
    "**/data/backups": true,
    "**/uv.lock": true,
    "**/package-lock.json": true,
    "**/coverage": true
  },

  // ─── Git ────────────────────────────────────────────────
  "git.ignoreLimitWarning": true,

  // ─── Mermaid (Markdown 미리보기에서 다이어그램 렌더) ──────
  "markdown.preview.fontSize": 13,

  // ─── 보안 ────────────────────────────────────────────────
  "files.readonlyInclude": {
    "**/.env": true,
    "**/.env.production": true,
    "**/kis_devlp.yaml": true,
    "**/token_*.json": true
  }
}
