# ═══════════════════════════════════════════════════════════════
# Nuri-Quant — gitignore
# ═══════════════════════════════════════════════════════════════
# Policy:
#   - Secrets/credentials: never commit (다층 패턴 방어)
#   - Lockfiles: track (uv.lock, package-lock.json) for reproducibility
#   - Build/cache/generated reports: ignore
#   - Personal state (portfolio, NEXT_SESSION, trade plans): ignore
#
# STRATEGY §4.4.1 privacy scanner 는 commit/PR/code 에서 broker name +
# monetary literal 을 차단 — 이 파일은 그 defense 의 1차 layer.

# ─── Secrets / Credentials ─────────────────────────────────────
.env
.env.*
!.env.example
.env.local
.env.*.local
.envrc

# KIS Open API 자격 증명 (절대 git 금지) — 다층 방어
# 1) 파일명 패턴 — 어디 있든 차단
**/kis_devlp.yaml
**/kis_devlp.yml
# 2) config/ 내부의 kis_ prefixed 파일
config/kis_*.yaml
config/kis_*.yml
# 3) config/kis/ 디렉토리 내부 전체 (credentials + token cache)
#    파일명이 바뀌어도, 새 secret이 추가되어도 안전
#    .gitkeep만 tracking해서 디렉토리 자체는 repo에 보존
config/kis/*
!config/kis/.gitkeep
# 4) 레거시 ~/KIS 참조 (프로젝트 외부지만 안전장치)
.kis/

# 토큰 캐시 (런타임 생성)
**/token_*.json
**/.tokens/

# Personal portfolio (보유 종목 정보)
config/portfolio.yaml

# Backlog + 개인 plan 노트 (broker names + ticker+PnL + 실현 손실 노출 — STRATEGY §4.4.1)
docs/TODO.md
docs/plans/
# 내부 운영 / audit / 파일 맵 — public OSS 가치 낮고 인프라 fingerprint / 약점 narrative 노출.
# 사용자 결정 (2026-05-03): 외부 노출 차단, local-only.
docs/OPERATIONS.md
docs/HARNESS_AUDIT.md
docs/TRADING_AUDIT.md
docs/SOURCE_OF_TRUTH.md

# TLS/SSL 인증서 + 개인 키 (defense-in-depth)
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
*.der
# 단, frontend public key/crt이 필요한 경우 explicit 예외 추가

# SSH 키
id_rsa
id_rsa.*
id_dsa
id_dsa.*
id_ecdsa
id_ed25519
id_ed25519.*
.ssh/

# 클라우드 자격증명
.aws/
.gcp/
.azure/
**/credentials.json
**/service-account*.json
**/gcloud-key*.json

# 일반 secret 파일 패턴
secrets.yaml
secrets.yml
secrets.json
*.secret
*.secrets

# DB 백업/덤프 (sensitive data 포함 가능)
*.dump
*.sql
*.sql.gz
*.sqlite
*.sqlite3
*.db.bak

# Rails-style DB config (defense-in-depth)
database.yml
database.yaml

# macOS keychain
*.keychain
*.keychain-db

# ─── Python ────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
# Root-anchored — Python build artifacts only. Without the leading slash
# any nested `lib/` directory (e.g. frontend/src/lib/) gets ignored, which
# bit us in #221 when new lib files needed `git add -f`.
/lib/
/lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
*.egg
MANIFEST

# ─── Virtual environments ──────────────────────────────────────
.venv/
venv/
env/
ENV/

# ─── Testing / Linting / Type checking ─────────────────────────
.pytest_cache/
.ruff_cache/
.mypy_cache/
.cache/
.tox/
.coverage
.coverage.*
coverage.xml
htmlcov/
.hypothesis/
test-results/
*.cover

# ─── Data & runtime artifacts ──────────────────────────────────
# SQLite DB files in data/ — glob form so future DB names (e.g. nuri.db,
# nuri.db-wal) are caught automatically. Only matches direct children;
# tests/fixtures/*.db remain trackable.
data/*.db
data/*.db-wal
data/*.db-shm
data/backups/
data/exports/
data/reports/
data/.bfg-reports/
# codex review archive (scripts/codex_review.sh output) — raw codex output may
# include code snippets we would not want in git history. Rollout JSONL at
# ~/.codex/sessions/ is the canonical source; this is a per-PR excerpt.
# Root-level (accessible via `ls codex-reviews/`) per user preference.
codex-reviews/
# scheduler.err/.log, auto-deploy log 등
data/logs/
# LLM dual-consult archives (scripts/llm_consult.py output) — prompts may
# carry portfolio context, verdicts may quote it. Decision audit trail kept
# locally, not committed. Mirror policy of codex-reviews/.
data/llm_consults/
# Agent loop transcripts (#578) — issue spec + patch + adversarial review.
# Codex/Qwen 가 issue body 를 스니펫으로 인용할 수 있어 portfolio context 노출
# 가능. local audit trail 만 보존, public repo 절대 금지.
data/agent_loop/
# Discord inbound listener (#582) — agent-control + agent-dev-log 채널 메시지/리액션
# raw payload. content 가 masked 라도 author_id 등 사용자 식별자 포함, public 금지.
data/discord_inbound/
# Thesis Q&A archive (#508) — DB context + LLM verdict 포함, portfolio holdings 노출
data/thesis_query/
# Portfolio recommendation backtracking archive (per-day .md) — broker holdings +
# rebalance proposals 노출, public repo 절대 금지. STRATEGY §4.4.1 privacy.
data/portfolio_recommendations/
# API health check heartbeat (scheduler 가 매분 rewrite)
data/.scheduler_heartbeat

# Logs
*.log
logs/

# BFG Repo-Cleaner artifacts (위치 무관)
**/*.bfg-report/
**/.bfg-reports/

# ─── Frontend (Next.js / Node) ─────────────────────────────────
node_modules/
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/coverage/
frontend/.turbo/
frontend/playwright-report/
frontend/test-results/
.next/
.turbo/

# ─── IDE / Editor ──────────────────────────────────────────────
# .vscode는 부분 공유 — 팀 표준 설정/extensions/launch/tasks는 트래킹
# 개인 파일만 무시
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json
.idea/
*.swp
*.swo
*~
.project
.pydevproject

# ─── Claude Code / AI assistants ───────────────────────────────
# Default-ignore .claude/ to keep personal state (settings.local.json,
# hooks drafts, notes) out of git. Explicitly allowlist the curated
# project-scoped assets so any Claude Code user working on this repo
# picks them up automatically.
#
# Skills allowlist: project 전용 `nuri-*` prefix 만 tracked.
# 머신별 개인 설치 skill (agents-langchain, prompt-engineer 등) 은
# 자동 ignored — repo 를 clone 한 다른 환경에 강제되지 않음.
.claude/*
!.claude/settings.json
!.claude/skills/
.claude/skills/*
!.claude/skills/nuri-*/
!.claude/agents/
.claude/agents/*
!.claude/agents/nuri-*.md
!.claude/commands/
.claude/commands/*
!.claude/rules/
.claude/rules/*
!.claude/rules/*.md
!.claude/commands/nuri-*.md

# ─── OS ────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ─── Build artifacts ───────────────────────────────────────────
*.backup
*.bak
*.tmp
*.orig
ta-lib/
ta-lib-*.tar.gz
NEXT_SESSION.md
# Personal trade plans (broker positions / prices — never commit)
TRADE_PLAN.md
TRADE_PLAN_*.md

# Internal methodology (not for public repo)
docs/SYSTEM.md
.gstack/

# Tool session state (codex consult, etc.)
.context/
