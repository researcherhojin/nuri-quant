# ═══════════════════════════════════════════════════════
# Nuri-Quant Environment Variables
# ═══════════════════════════════════════════════════════
# cp .env.example .env → 필요한 값만 설정
# 대부분 optional (fallback 존재)

# ═══ API Keys ═══
FRED_API_KEY=your_fred_api_key_here       # (optional) FRED macro — yfinance fallback available
# FMP_API_KEY=your_fmp_key_here           # (optional) unlocks OpenBB ratios/ownership
# FINNHUB_API_KEY=your_finnhub_key_here   # (optional) US institutional flows

# ═══ Discord ═══
# DISCORD_WEBHOOK_URL=                    # daily report webhook (optional, falls back to stdout)
# DISCORD_BOT_TOKEN=                      # bot mode (optional)
# DISCORD_CHANNEL_ID=

# ═══ Telegram ═══
# TELEGRAM_BOT_TOKEN=                     # Telegram 봇 알림 (optional)
# TELEGRAM_CHAT_ID=                       # 알림 수신 채팅 ID

# ═══ LLM (Ollama) ═══
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3.5                      # 권장: qwen3.5 (M2 Pro 32GB 최적)
# LLAMA_MODEL_PATH=/path/to/model.gguf   # (optional) llama.cpp 직접 실행

# ═══ API Server ═══
API_PORT=8001                             # FastAPI port (default 8001)

# ═══ API Security ═══
# API_AUTH_ENABLED=true                   # true → JWT/API key 인증 활성화
# API_KEY=your_secret_key_here            # Bearer token 인증
# API_SECRET_KEY=your_jwt_secret          # JWT 서명 키 (미설정 시 랜덤 생성)
# CORS_ORIGINS=https://your-domain.com    # 프로덕션 CORS 도메인 (쉼표 구분)

# ═══ Dashboard Auth ═══
# DASHBOARD_PASSWORD=                     # (optional) set to enable password protection

# ═══ Paper Trading ═══
# ALPACA_API_KEY=                         # (optional) Alpaca paper trading
# ALPACA_SECRET_KEY=
# ALPACA_BASE_URL=https://paper-api.alpaca.markets

# ═══ Mac Mini (Production) ═══
# MACMINI_HOST=macmini.local
# MACMINI_USER=ehbebe
# MACMINI_PATH=~/nuri-quant
