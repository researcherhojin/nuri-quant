# ═══════════════════════════════════════════════════════════════
# Nuri-Quant 환경 변수 템플릿
# ═══════════════════════════════════════════════════════════════
# 사용법
#   cp .env.example .env && chmod 600 .env
#   필요한 값만 채운다. 모든 키는 선택이며, 미설정 시 해당 기능이 꺼지거나 기본값으로 동작한다.
#
# 작성 규칙
#   - `KEY=` (활성, 빈 값): 코드가 빈 문자열을 "미설정" 으로 처리하는 키.
#   - `# KEY=값` (주석): 코드에 기본값이 있는 키. 바꿀 때만 주석을 해제한다.
#     기본값이 있는 키를 빈 값으로 활성화하면 기본값 대신 빈 문자열이 적용된다.
#   - 설명은 키 바로 위 줄에 둔다. 같은 줄에 주석을 붙이면 값으로 파싱된다
#     (tests/core/test_env_example_parses.py).
#
# 보안
#   - .env 는 커밋하지 않는다 (.gitignore). 이 파일에는 값을 넣지 않는다.
#   - 노출이 의심되면 해당 키를 즉시 재발급한다.
#   - `make deploy-mini` 는 이 머신의 .env 를 Mac mini 로 복사한다. 머신별로
#     달라야 하는 값(DEV2_HOST, NURI_ROLE)은 여기에 두지 않는다 (§9 참조).
# ═══════════════════════════════════════════════════════════════


# ───────────────────────────────────────────────────────────────
# 1. 한국투자증권 KIS Open API
# ───────────────────────────────────────────────────────────────
# 읽는 곳: nuri/collectors/kis_realtime.py `load_credentials(mode)` — 접두어 KIS_PROD / KIS_PAPER.
# 자격 증명 탐색 순서: 1) 아래 환경 변수  2) config/kis/kis_devlp.yaml  3) ~/KIS/config/kis_devlp.yaml
# 시세·잔고 조회만 호출하며 주문 API 는 호출하지 않는다 (STRATEGY §7.1).
# 발급: https://apiportal.koreainvestment.com

# 실전 (mode="prod")
KIS_PROD_APP_KEY=
KIS_PROD_APP_SECRET=
# 계좌번호 8자리
KIS_PROD_ACCOUNT=

# 모의 (mode="paper")
KIS_PAPER_APP_KEY=
KIS_PAPER_APP_SECRET=
# 계좌번호 8자리
KIS_PAPER_ACCOUNT=

# HTS ID — 실시간 WebSocket 시세에 필요
KIS_HTS_ID=


# ───────────────────────────────────────────────────────────────
# 2. Toss Open API
# ───────────────────────────────────────────────────────────────
# 읽는 곳: nuri/collectors/toss.py. 자격 증명 탐색 순서: 1) 아래 환경 변수  2) config/toss/toss_devlp.yaml
# 시세·환율·잔고 조회만 호출한다 (STRATEGY §7.1). 검증: python -m nuri.collectors.toss --verify
# 발급: https://developers.tossinvest.com

# 개발자센터 "API Key" (OAuth client_id)
TOSS_API_KEY=
# 개발자센터 "Secret Key" (OAuth client_secret)
TOSS_SECRET_KEY=
# 선택 — 계좌·보유 조회용 accountSeq
TOSS_ACCOUNT_SEQ=


# ───────────────────────────────────────────────────────────────
# 3. LLM
# ───────────────────────────────────────────────────────────────
# 외부 LLM 은 nuri/llm/openai_client.py 를 통해서만 호출하며, 호출마다
# external_llm_calls 테이블에 메타데이터(시각·모델·토큰)를 기록한다 (내용은 기록하지 않는다).
# 정책: STRATEGY §4.4.3. 추천 파이프라인 자체는 LLM 을 쓰지 않는다.

# OpenAI API 키. 미설정 시 헤드라인 분류는 정규식 폴백, 일간 리포트는 로컬 LLM 폴백.
OPENAI_API_KEY=

# 일간 리포트 모델 (nuri/llm/report.py). 기본값 gpt-5.4-nano.
# OPENAI_REPORT_MODEL=gpt-5.4-nano

# 포트폴리오 데이터(Tier 2)를 외부로 보내도 된다는 확인. OpenAI ZDR 승인 후에만 1 로 설정한다.
# 미설정 시 Tier 2 호출은 ExternalLLMPolicyViolation 을 발생시킨다.
# OPENAI_ZDR_APPROVED=1

# 모든 외부 LLM 호출 차단 (CI · 오프라인 · 프라이버시 모드). 1 이면 ExternalLLMDisabled 를 발생시킨다.
# NURI_DISABLE_EXTERNAL_LLM=1

# 로컬 LLM 폴백 (nuri/llm/report.py) — OpenAI 실패 또는 외부 호출 차단 시 이 순서로 시도한다.
# llama.cpp GGUF 파일 경로. 비어 있으면 건너뛴다.
# LLAMA_MODEL_PATH=/path/to/model.gguf
# Ollama 서버 주소. 비어 있으면 비활성.
# OLLAMA_HOST=http://localhost:11434
# Ollama 모델. 기본값 qwen3.5.
# OLLAMA_MODEL=qwen3.5

# 개발용 이중 자문 스크립트 scripts/dev/llm_consult.py 의 로컬 모델 (OpenAI 호환 엔드포인트).
# 기본값: http://127.0.0.1:1234/v1/chat/completions (LM Studio), lmstudio-community/muse-glimmer-30b.
# 구 이름 NURI_LLM_QWEN_URL / NURI_LLM_QWEN_MODEL 도 읽으며, 새 이름이 우선한다.
# NURI_LLM_LOCAL_URL=http://127.0.0.1:1234/v1/chat/completions
# NURI_LLM_LOCAL_MODEL=lmstudio-community/muse-glimmer-30b


# ───────────────────────────────────────────────────────────────
# 4. 데이터 소스
# ───────────────────────────────────────────────────────────────
# FRED 매크로·경제 일정 (collectors/macro.py, fred_calendar.py). 미설정 시 yfinance 폴백.
FRED_API_KEY=
# 미국 기관 수급 (collectors/institutional.py). 미설정 시 미국 종목 수집을 건너뛴다.
FINNHUB_API_KEY=


# ───────────────────────────────────────────────────────────────
# 5. 알림 — Discord / Telegram
# ───────────────────────────────────────────────────────────────
# 모두 선택. 미설정 채널은 발송을 건너뛴다.

# 5-a. Discord 봇 (nuri/agents/discord/bot.py — launchd com.nuri-quant.discord-bot)
#   설치: make crons-install ARGS="--only discord-bot"
#   봇은 Message Content Intent 를 요청한다. Developer Portal > Bot > Privileged Gateway
#   Intents 에서 켜지 않으면 PrivilegedIntentsRequired 로 기동에 실패한다.
DISCORD_BOT_TOKEN=
# 서버(guild) ID — slash 명령을 이 서버에 등록한다
DISCORD_GUILD_ID=

# 5-b. 수신 채널 ID (nuri/agents/discord/inbound.py) — 둘 다 없으면 수신 리스너가 붙지 않는다
# #agent-control — HITL 승인(✅/❌ 반응)
DISCORD_CHANNEL_AGENT_CONTROL_ID=
# #agent-dev-log — 에이전트 대화 기록
DISCORD_CHANNEL_AGENT_DEV_LOG_ID=
# 수신 메시지 저장 경로. 기본값 data/discord_inbound
# NURI_DISCORD_INBOUND_DIR=data/discord_inbound

# 5-c. 발송 webhook (nuri/agents/discord/publisher.py `Channel` — 값마다 DISCORD_WEBHOOK_<값>)
#   메시지가 가는 Discord 채널은 webhook 을 만든 채널이 정한다.
# Channel.BRIEF — 일별 시장 브리프
DISCORD_WEBHOOK_BRIEF=
# Channel.OPS — 운영 알림
DISCORD_WEBHOOK_OPS=
# Channel.INCIDENTS — 장애
DISCORD_WEBHOOK_INCIDENTS=
# Channel.ROLLOUT — 가설 카나리
DISCORD_WEBHOOK_ROLLOUT=
# Channel.AGENT_CONTROL — HITL 승인 요청
DISCORD_WEBHOOK_AGENT_CONTROL=
# Channel.AGENT_DEV_LOG — 에이전트 대화 기록
DISCORD_WEBHOOK_AGENT_DEV_LOG=

# 5-d. 단일 채널 방식 (구버전)
# 일간 리포트 (alerts/daily_report.py) 와 heartbeat_watchdog 의 마지막 폴백 webhook
DISCORD_WEBHOOK_URL=
# 구 양방향 봇 nuri/alerts/discord_bot.py 전용. CHANNEL_ID 는 정수로 변환하므로 쓸 때만 주석을 해제한다.
# DISCORD_TOKEN=
# DISCORD_CHANNEL_ID=

# 5-e. Telegram (alerts/telegram.py)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=


# ───────────────────────────────────────────────────────────────
# 6. 모의 주문 브로커 (Alpaca paper)
# ───────────────────────────────────────────────────────────────
# 읽는 곳: nuri/trading/execution/broker.py `AlpacaBroker`. 추천 파이프라인은 주문을 호출하지 않는다 (STRATEGY §7.1).
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# 기본값 https://paper-api.alpaca.markets
# ALPACA_BASE_URL=https://paper-api.alpaca.markets


# ───────────────────────────────────────────────────────────────
# 7. API 서버 (nuri/api)
# ───────────────────────────────────────────────────────────────
# 포트. 기본값 8001 (api/main.py, heartbeat_watchdog 포트 점검).
# API_PORT=8001

# JWT 서명 키 (api/auth.py). 미설정 시 부팅마다 임의 생성되어 재시작 시 발급된 JWT 가 모두 무효가 된다.
# 운영에서는 설정한다. Mac mini 와 개발 머신에 같은 값이 필요하다 (deploy-mini 가 .env 를 복사).
# 생성: python3 -c "import secrets; print(secrets.token_hex(32))"
# 빈 값으로 활성화하지 않는다 — 빈 문자열이 서명 키가 된다.
# API_SECRET_KEY=

# API 인증 (api/auth.py `require_auth` · `require_write_auth`). 기본값 false — 인증 없이 통과.
# API_AUTH_ENABLED=true
# Bearer API 키 — API_AUTH_ENABLED=true 일 때 JWT 대신 쓸 수 있다
API_KEY=

# CORS 허용 출처 (쉼표 구분). 기본값 http://localhost:3000,http://127.0.0.1:3000
# 빈 값으로 활성화하면 허용 출처가 없어진다.
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# 무거운 핸들러 동시 실행 상한 (api/limits.py). 기본값 8.
# NURI_API_HEAVY_SLOTS=8

# SQLite 경로 (core/db/connection.py). 기본값 data/portfolio.db
# NURI_DB_PATH=data/portfolio.db


# ───────────────────────────────────────────────────────────────
# 8. 대시보드 인증
# ───────────────────────────────────────────────────────────────
# 대시보드 비밀번호. 두 프로세스가 각자의 파일에서 읽으므로 두 곳에 같은 값을 둔다.
#   - 프론트 미들웨어 (frontend/src/middleware.ts): frontend/.env.local. 미설정 시 인증 없이 공개.
#   - 백엔드 (nuri/api/main.py `POST /api/auth/token`): 이 파일. 미설정 시 503 을 반환한다.
# DASHBOARD_PASSWORD=
#
# AUTH_SECRET 은 프론트 전용이며 frontend/.env.local 에만 둔다 (이 파일은 읽지 않는다).
# 쿠키 서명 키로, 미설정 시 DASHBOARD_PASSWORD 를 키로 써서 비밀번호를 바꾸면 세션이 모두 무효가 된다.
# 프론트 환경 변수 전체: frontend/README.md


# ───────────────────────────────────────────────────────────────
# 9. 배포 · 운영
# ───────────────────────────────────────────────────────────────
# `make deploy` (scripts/deploy/deploy_remote.sh) 대상. `make deploy-mini` 는 이 값을 쓰지 않는다.
# 기본값 macmini.local
# MACMINI_HOST=macmini.local
# 원격 계정 — make deploy 에 필수
MACMINI_USER=
# 기본값 ~/nuri-quant
# MACMINI_PATH=~/nuri-quant

# 대시보드 포트 — heartbeat_watchdog 의 포트 점검용. 기본값 3000.
# FRONTEND_PORT=3000

# 스케줄러 로그 (nuri/scheduler.py). 기본 경로 data/logs. 1 이면 파일 로그를 끈다.
# NURI_SCHEDULER_LOG_DIR=data/logs
# NURI_SCHEDULER_LOG_DISABLE_FILE=1

# 이 파일에 두지 않는 값 (deploy-mini 가 .env 를 복사하므로 머신별 값이 덮어써진다)
#   DEV2_HOST — `make deploy-mini` 대상 호스트. ~/.zshrc 에 export 한다.
#   NURI_ROLE — production 일 때만 월간 alpha 리포트를 #brief 로 보낸다 (STRATEGY §3.11).
#               위치: scripts/launchd/com.nuri-quant.scheduler.plist 의 EnvironmentVariables.
