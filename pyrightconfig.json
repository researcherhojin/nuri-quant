{
  // 저장소의 Python 전부 — 운영 · CI 가 실제로 돌리는 scripts/ 포함 (2026-10-12; 그 전엔 nuri · tests
  // 뿐이라 scripts 의 오류 7건이 IDE · 전체 실행 어디에도 안 보였다). 오류는 0 이고, CI 의 Backend Lint
  // 가 pyright 1.1.414 로 0 을 강제한다 (#1831). pre-push 의 scripts/verify/check_pyright_diff.py 는
  // 바꾼 줄만 보는 빠른 로컬 사본이다.
  "include": ["nuri", "tests", "scripts"],
  "exclude": [
    // 완결된 사전등록 에피소드 스크립트 — 결과가 아카이브된 일회성 실험이라 사후
    // 수정을 하지 않는 게 원칙이고, 타입 소음도 고치지 않는다 (2026-08-30).
    "scripts/episodes",
    "**/.*",
    "**/__pycache__",
    "**/.venv",
    "**/.pytest_cache",
    "**/node_modules"
  ],
  "pythonVersion": "3.12",
  "typeCheckingMode": "basic",
  "extraPaths": ["."],
  "venvPath": ".",
  "venv": ".venv",
  "executionEnvironments": [
    {
      // 테스트는 mock · 일부만 채운 dict · 일부러 틀린 인자(에러 경로)를 쓴다 (#644). 이 다섯 규칙을
      // 켜면 tests 오류가 40 → 240 건이 되고, 늘어난 200 건이 전부 그런 의도된 패턴이다 (2026-10-12 실측).
      "root": "tests",
      "reportOperatorIssue": "none",
      "reportArgumentType": "none",
      "reportCallIssue": "none",
      "reportOptionalSubscript": "none",
      "reportOptionalMemberAccess": "none"
    }
  ]
}
